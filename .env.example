# HALLOWEEN DO NEW LIFE
# MODELO DE CONFIGURAÇÃO — copie para .env para usar como ponto de partida.
#
# COMO USAR
# 1. Para som, tempos, câmera ou movimento: edite e reinicie python main.py.
# 2. Para testar só o som: python main.py --testar-audio
# 3. Para calibrar movimento sem som: python main.py --calibrar
# 4. Para mudar textos ou efeitos gravados: veja as seções 9 a 13.
#
# ATALHOS PARA OS AJUSTES MAIS COMUNS
# Falas de socorro baixas: BACKGROUND_SCREAMS_VOLUME (seção 1).
# Tempo do ambiente final: AMBIENCE_SECONDS (seção 2).
# Repetir sem espera: REARM_QUIET_SECONDS=0 e COOLDOWN_SECONDS=0 (seção 2).
# Sensibilidade do movimento: seção 5.
# Todos os tempos estão em segundos, exceto campos identificados de outra forma.
# Variáveis do terminal têm prioridade sobre este arquivo.
# S interrompe manualmente o som e exige pelo menos 2 s de repouso antes de rearmar.

# ============================================================================
# 1. VOLUME DO SOM — reinicie o programa após alterar
# ============================================================================
# Valores de 0 a 1: 0 = mudo, 0.25 = 25%, 1 = volume máximo do programa.
# O volume geral multiplica os demais; o volume das caixas também depende do sistema.

# Volume geral de toda a sequência.
MASTER_VOLUME=0.90

# sons_e_boas_vindas: somente barulhos e a saudação do New Life.
# completo: inclui também as mensagens de socorro e ameaças ao fundo.
# Reinicie o programa após trocar. A montagem de exemplo reflete a última geração.
AUDIO_MODE=sons_e_boas_vindas

# Volume da abertura: grito inicial, boas-vindas e gargalhada.
INTRO_VOLUME=1.0

# Volume do susto forte que acontece depois da pausa.
SCARE_VOLUME=1.0

# Volume dos outros gritos, das falas de socorro/bruxa e da motosserra.
# Aumente este campo se essas mensagens estiverem baixas. 0 desativa o fundo.
BACKGROUND_SCREAMS_VOLUME=0.25

# Volume do ambiente final: vento, morcegos, sussurros e madeira rangendo.
# Este campo não controla as falas de socorro: use BACKGROUND_SCREAMS_VOLUME.
AMBIENCE_VOLUME=0.40

# ============================================================================
# 2. TEMPOS, SUSTO E REPETIÇÃO — valores em segundos
# ============================================================================
# Reinicie o programa após alterar. Para atualizar o arquivo de exemplo, regenere o áudio.

# true ativa o susto depois da pausa; false pula essa etapa.
# O grito inicial é controlado separadamente por OPENING_SCREAM_GAIN.
SCARE_ENABLED=true

# Pausa depois da gargalhada e antes do susto. As vozes de fundo continuam.
SCARE_DELAY_SECONDS=3

# Quanto tempo o ambiente continua DEPOIS que o susto termina.
AMBIENCE_SECONDS=30

# Nos últimos segundos do ambiente, o som diminui até parar.
# Não pode ultrapassar AMBIENCE_SECONDS. Use 0 para encerrar sem essa redução.
AMBIENCE_FADE_SECONDS=2

# Interrompe TODOS os sons após este tempo sem movimento, em qualquer etapa.
# Ao detectar movimento novamente, pode recomeçar. 0 desativa a interrupção.
# Não afeta --testar-audio, que reproduz sem depender da câmera.
STOP_IF_NO_MOTION_SECONDS=5

# Tempo de cena parada exigido antes de aceitar outro disparo.
# Use 0 para permitir repetição mesmo se as pessoas continuarem se movendo.
REARM_QUIET_SECONDS=0

# Espera mínima entre o fim de um ciclo e o começo do próximo.
# Para repetir imediatamente com movimento, deixe este campo e REARM_QUIET_SECONDS em 0.
COOLDOWN_SECONDS=0

# ============================================================================
# 3. CÂMERA — escolha do dispositivo e qualidade
# ============================================================================
# Reinicie o programa após alterar. Resolução e FPS dependem do que a webcam aceita.

# Número da webcam: 0 é a primeira, 1 é a segunda, e assim por diante.
# Neste Mac, a REDRAGON Live Camera foi identificada como 0.
CAMERA_INDEX=0

# Modo de acesso: auto = automático; avfoundation = macOS;
# dshow ou msmf = Windows; v4l2 = Linux.
CAMERA_BACKEND=auto

# Largura solicitada à câmera, em pixels.
CAMERA_WIDTH=1280

# Altura solicitada à câmera, em pixels.
CAMERA_HEIGHT=720

# Quadros por segundo solicitados à webcam. 30 costuma dar uma imagem fluida.
CAMERA_FPS=30

# Quantidade de falhas seguidas de leitura antes de encerrar com erro.
# É uma contagem de quadros com falha, não um tempo em segundos.
CAMERA_MAX_READ_FAILURES=20

# ============================================================================
# 4. VISUALIZAÇÃO DA CÂMERA
# ============================================================================
# Reinicie o programa após alterar. true = ligado; false = desligado.
# F alterna tela cheia; Q encerra; Esc sai da tela cheia ou encerra se estiver em janela.

# Mostra a imagem da webcam. false executa sem janela; encerre com Ctrl+C.
SHOW_PREVIEW=true

# false abre uma janela no tamanho original da imagem da câmera.
# true abre em tela cheia, preservando a proporção da imagem.
PREVIEW_FULLSCREEN=false

# false mantém a orientação real da cena; true espelha a imagem como um espelho.
MIRROR_PREVIEW=false

# Exibe retângulos, porcentagem de movimento e informações sobre a imagem.
SHOW_DETECTION_OVERLAY=false

# Exibe um pequeno painel em preto e branco com as áreas que mudaram.
# O modo --calibrar sempre mostra esse painel e os indicadores, sem tocar áudio.
SHOW_MASK=false

# ============================================================================
# 5. SENSIBILIDADE DO MOVIMENTO — os ajustes mais usados
# ============================================================================
# Calibre com: python main.py --calibrar
# Mude um campo por vez e reinicie. A câmera deve ficar fixa.

# Tempo inicial para aprender a cena. Mantenha a câmera e o ambiente parados.
WARMUP_SECONDS=3

# Diferença mínima de brilho para considerar um pixel alterado (1 a 254).
# Menor = detecta movimentos mais sutis; maior = ignora mais ruído.
DIFFERENCE_THRESHOLD=25

# Tamanho mínimo de uma região de movimento, em pixels da imagem PROCESSADA.
# Menor = detecta objetos menores. Recalibre ao mudar PROCESSING_WIDTH.
MIN_CONTOUR_AREA=1600

# Fração mínima da área monitorada que precisa mudar: 0.008 = 0,8%.
# Menor = mais sensível. Também é necessário atingir MIN_CONTOUR_AREA.
MIN_MOTION_RATIO=0.008

# Acima desta fração, ignora o quadro como possível mudança global de luz.
# 0.70 = 70%. Use 1 para desativar esse filtro, ou aumente para pessoas muito próximas.
MAX_MOTION_RATIO=0.70

# Quantos quadros seguidos precisam indicar movimento para confirmar um disparo.
# Maior = menos falsos disparos, mas leva um pouco mais para confirmar.
CONSECUTIVE_FRAMES=3

# Só inicia o áudio após MAIS deste tempo de movimento contínuo, em segundos.
# Se o movimento parar, a contagem zera. 0 usa apenas CONSECUTIVE_FRAMES.
# Se o movimento continuar durante todo o ciclo, pode repetir sem nova espera.
START_MOTION_SECONDS=3

# ============================================================================
# 6. ÁREA MONITORADA — região de interesse (ROI)
# ============================================================================
# Valores são frações de 0 a 1 da imagem ORIGINAL, antes do espelhamento.
# X + WIDTH e Y + HEIGHT não podem passar de 1.
# Imagem inteira: X=0, Y=0, WIDTH=1, HEIGHT=1.
# Metade central: X=0.25, Y=0, WIDTH=0.5, HEIGHT=1.

# Posição horizontal do início da área: 0 = borda esquerda.
ROI_X=0

# Posição vertical do início da área: 0 = borda superior.
ROI_Y=0

# Largura da área monitorada, como fração da largura total.
ROI_WIDTH=1

# Altura da área monitorada, como fração da altura total.
ROI_HEIGHT=1

# ============================================================================
# 7. DESEMPENHO E FILTROS DE MOVIMENTO — ajustes avançados
# ============================================================================
# Estes campos afetam a detecção. A prévia continua usando a imagem original da câmera.

# Largura usada para analisar movimento, em pixels. Menor economiza processamento.
# Ao alterar, ajuste MIN_CONTOUR_AREA: a área dos objetos também muda.
PROCESSING_WIDTH=640

# Máximo de análises por segundo. Menor economiza processamento, mas reage mais devagar.
PROCESSING_FPS=20

# Suaviza pequenos ruídos da imagem. Deve ser ímpar: 1, 3, 5, ... 21, ... 101.
# Maior suaviza mais, podendo esconder movimentos pequenos.
BLUR_KERNEL=21

# Velocidade de atualização da imagem de referência (0.0001 a 1).
# Maior absorve mudanças mais rápido; uma pessoa parada pode passar a fazer parte do fundo.
BACKGROUND_ALPHA=0.035

# Quantidade de etapas para juntar pixels alterados próximos (0 a 10).
# 0 desativa. Maior ajuda a unir movimentos fragmentados, mas pode aumentar o ruído.
DILATE_ITERATIONS=2

# ============================================================================
# 8. SAÍDA DE SOM E ARQUIVOS USADOS NA REPRODUÇÃO
# ============================================================================
# Caminhos relativos começam na pasta do projeto; caminhos absolutos também funcionam.
# Use arquivos WAV PCM de 16 bits, mono ou estéreo. Reinicie após trocar os caminhos.

# Nome do dispositivo de saída. Deixe vazio para usar a saída padrão do sistema.
AUDIO_DEVICE=

# Tamanho do buffer de som. 1024 é um ponto de partida estável.
# Se houver estalos, tente 2048. Valores menores reduzem a latência.
AUDIO_BUFFER=1024

# Abertura: grito forte, morcegos, boas-vindas e gargalhada.
AUDIO_INTRO=audio/01_boas_vindas.wav

# Susto forte depois da pausa.
AUDIO_SCARE=audio/02_susto.wav

# Ambiente final. Repete este arquivo até completar AMBIENCE_SECONDS.
AUDIO_AMBIENCE=audio/03_ambiente.wav

# Fundo independente com os outros gritos, as cinco falas e a motosserra.
# Toca junto de todas as etapas e para quando o ciclo termina.
AUDIO_BACKGROUND_SCREAMS=audio/04_gritos_fundo.wav

# Fundo com gritos SEM palavras e motosserra, usado em sons_e_boas_vindas.
AUDIO_BACKGROUND_SOUNDS=audio/05_fundo_sons.wav

# Arquivo completo montado pelo gerador, para ouvir em um reprodutor.
# Não é usado para controlar as etapas ao vivo; o programa usa os arquivos acima.
AUDIO_EXAMPLE=audio/halloween_exemplo.wav

# ============================================================================
# 9. GERAR ÁUDIO — FALA PRINCIPAL DE BOAS-VINDAS
# ============================================================================
# A partir desta seção, alterações exigem regenerar os WAV.
# Para mudar o texto ou a voz principal: python gerar_audio.py
# Para reutilizar a fala principal já salva: python gerar_audio.py --reutilizar-voz
# Criar falas novas no macOS usa say e FFmpeg. Os arquivos já fornecidos tocam sem eles.

# Frase pronunciada nas boas-vindas. Use aspas para manter espaços e pontuação.
SPEECH_TEXT="Bem-vindos ao Halloween do New Life!"

# Saudação pronta usada no modo sons_e_boas_vindas. Nenhuma fala nova é sintetizada.
# Para mudar a frase nesse modo, substitua esta gravação e atualize SPEECH_TEXT.
SOURCE_GREETING_VOICE=audio/falas_ia/boas_vindas.wav
# SPEECH_VOICE e SPEECH_RATE abaixo se aplicam à geração local do modo completo.

# Nome da voz do sistema. No macOS, liste as vozes com: say -v '?'
# No Linux, instale espeak-ng e escolha uma voz como pt-br.
SPEECH_VOICE="Grandma (Português (Brasil))"

# Velocidade da fala principal, em palavras por minuto. Menor = mais lenta.
SPEECH_RATE=112

# Variação do tom e da velocidade da gravação: 1 mantém o original.
# Menor que 1 deixa mais grave e lento; maior que 1 deixa mais agudo e rápido.
VOICE_PITCH=0.96

# Nível da voz principal na montagem (0 a 1). Exige regenerar os WAV.
# Para mudar o volume ao reproduzir, sem regenerar, use INTRO_VOLUME.
VOICE_GAIN=0.45

# ============================================================================
# 10. GERAR ÁUDIO — GRITOS E EFEITOS DA SEQUÊNCIA PRINCIPAL
# ============================================================================
# Campos terminados em _GAIN controlam a mistura salva no arquivo (0 a 1).
# Depois de alterar, execute: python gerar_audio.py --reutilizar-voz

# Força do grito logo na abertura. 0 remove esse grito.
OPENING_SCREAM_GAIN=1.0

# Mantém os gritos fortes por mais tempo sem recortar os picos.
# 1 = sem compressão; 3.5 = valor atual; até 8 = mais denso.
SCREAM_COMPRESSION_RATIO=3.5

# Nível do susto forte dentro do arquivo gerado.
SCARE_GAIN=1.0

# Nível das asas e guinchos dos morcegos na montagem.
BATS_GAIN=0.18

# Nível das gargalhadas de bruxa na montagem.
WITCH_GAIN=0.45

# Nível da mistura do ambiente final dentro do arquivo gerado.
AMBIENCE_GAIN=0.30

# Duração, em segundos, do arquivo de susto gerado. Não é a pausa antes dele.
SCARE_SOUND_SECONDS=2.5

# ============================================================================
# 11. GERAR ÁUDIO — FALAS, GRITOS DISTANTES E MOTOSSERRA
# ============================================================================
# Para aumentar tudo isso durante a reprodução, use BACKGROUND_SCREAMS_VOLUME na seção 1.
# As opções abaixo mudam o conteúdo da gravação e exigem regenerar os WAV.

# Falas separadas pelo caractere |, dentro de aspas.
# As três primeiras usam a voz de socorro; as demais usam a voz da bruxa.
# Alterar as frases exige sintetizar as novas falas; as antigas ficam em cache para reutilização.
BACKGROUND_SPEECH_TEXTS="Socorro!|Me salve!|Estou preso aqui!|Eu vou matar você!|Não adianta correr!"

# Voz das três primeiras falas: Socorro!, Me salve! e Estou preso aqui!
BACKGROUND_HELP_VOICE="Eddy (Português (Brasil))"

# Voz das demais falas: Eu vou matar você! e Não adianta correr!
BACKGROUND_WITCH_VOICE="Grandma (Português (Brasil))"

# Velocidade das falas de socorro, em palavras por minuto.
# O gerador usa uma velocidade 20% menor para as falas da bruxa.
BACKGROUND_SPEECH_RATE=145

# Menor intervalo possível entre o início de duas falas de fundo.
# As vozes podem se sobrepor se a fala for mais longa que o intervalo.
BACKGROUND_MIN_INTERVAL_SECONDS=1.5

# Maior intervalo possível entre o início das falas. Deve ser >= ao mínimo.
BACKGROUND_MAX_INTERVAL_SECONDS=2.8

# Nível da motosserra dentro do fundo (0 a 1).
# Diminua para destacar mais as vozes em relação ao motor.
CHAINSAW_GAIN=0.35

# ============================================================================
# 12. GERAR ÁUDIO — DURAÇÃO DOS ARQUIVOS E FORMATO
# ============================================================================
# A duração dos arquivos em loop é diferente da duração total da reprodução.

# Duração do arquivo de ambiente que será gerado.
# Quem determina por quanto tempo ele toca no ciclo é AMBIENCE_SECONDS, na seção 2.
AMBIENCE_LOOP_SECONDS=30

# Duração do arquivo de gritos e falas de fundo.
# Ao terminar o arquivo, repete se o ciclo ainda estiver em andamento.
BACKGROUND_LOOP_SECONDS=45

# Frequência do áudio em Hz: 22050, 44100 ou 48000.
# Usada tanto na geração quanto na saída de som; regenere os WAV ao alterar.
AUDIO_SAMPLE_RATE=44100

# Número que define a distribuição aleatória dos sons nos arquivos gerados.
# O mesmo número produz a mesma montagem. Mude e regenere para variar a distribuição.
RANDOM_SEED=31

# ============================================================================
# 13. FONTES DOS EFEITOS — troca opcional dos sons originais
# ============================================================================
# Arquivos incluídos no projeto. Autores e licenças estão em audio/FONTES.md.
# Ao trocar qualquer fonte, regenere os WAV. Use WAV PCM de 16 bits.

# Gravação usada para as gargalhadas de bruxa.
SOURCE_WITCH_LAUGH=audio/fontes/risada_bruxa.wav

# Gravação usada para os gritos fortes e variações dos gritos distantes.
SOURCE_WITCH_SCREAM=audio/fontes/grito_bruxa.wav

# Gravação de guinchos de morcegos.
SOURCE_BAT=audio/fontes/morcego.wav

# Gravação de asas batendo.
SOURCE_WINGS=audio/fontes/asas.wav

# Som de vento usado na ambientação.
SOURCE_WIND=audio/fontes/vento.wav

# Porta de madeira batendo, misturada ao susto.
SOURCE_WOOD_SLAM=audio/fontes/porta_batendo.wav

# Madeira rangendo no ambiente final.
SOURCE_WOOD_CREAK=audio/fontes/madeira_rangendo.wav

# Gravação da motosserra usada no fundo.
SOURCE_CHAINSAW=audio/fontes/motosserra.wav

# ============================================================================
# 14. DIAGNÓSTICO
# ============================================================================
# Quantidade de detalhes no terminal: DEBUG, INFO, WARNING ou ERROR.
# INFO mostra os eventos principais; DEBUG também mostra detalhes dos erros.
LOG_LEVEL=INFO
